# Copy to apps/web/.env.local (Next.js reads env from its own dir).
# Server-only secrets must NOT be prefixed with NEXT_PUBLIC_.

# ---- Sui ----
NEXT_PUBLIC_SUI_RPC_URL=https://fullnode.testnet.sui.io:443
NEXT_PUBLIC_SUI_NETWORK=testnet
NEXT_PUBLIC_PACKAGE_ID=0x...
NEXT_PUBLIC_HOUSEHOLD_REGISTRY_ID=0x...
NEXT_PUBLIC_TREASURY_ID=0x...            # set by scripts/seed.ts
NEXT_PUBLIC_ZONE_ID=0x...                # set by scripts/seed.ts
NEXT_PUBLIC_EXPLORER_BASE=https://testnet.suivision.xyz
ADMIN_CAP_ID=0x...
ADMIN_PRIVATE_KEY=suiprivkey1...         # server-only — owns AdminCap
SPONSOR_PRIVATE_KEY=suiprivkey1...       # server-only — pays gas for all users

# ---- Auth (zkLogin + demo) ----
NEXT_PUBLIC_GOOGLE_CLIENT_ID=...apps.googleusercontent.com
NEXT_PUBLIC_AUTH_MODE=google             # informational; Google shows whenever the client id is set
NEXT_PUBLIC_SHOW_DEMO_LOGINS=true        # set false to hide the browser-key demo accounts
NEXT_PUBLIC_ZKLOGIN_MAX_EPOCH_OFFSET=10  # epochs the zkLogin proof stays valid
ZKLOGIN_PROVER_URL=https://prover-dev.mystenlabs.com/v1
ZKLOGIN_SALT_SECRET=...                  # server-only — HMAC key for per-user salt derivation

# ---- Supabase (read-mirror) ----
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=...
SUPABASE_SERVICE_ROLE_KEY=...            # server-only

# ---- GonkaRouter (AI, server-only) ----
GONKA_API_KEY=sk-...
GONKA_BASE_URL=https://api.gonkarouter.io/v1
GONKA_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731

# Zone credibility multi-model consensus (kill switch): set to false to hide
# it everywhere (admin evidence UI, public dashboard line, both API routes
# refuse to run) with one change. Needs supabase/0004_zone_credibility.sql.
NEXT_PUBLIC_ENABLE_ZONE_CREDIBILITY=true

# ---- Admin console ----
ADMIN_CONSOLE_SECRET=...                 # server-only — passcode gate for /api/admin/*

# ---- Demo seed data (scripts/seed.ts) ----
SEED_ZONE_NAME=Kampung Test Flood 2026
SEED_ELIGIBLE_POSTCODES=43000,43100,43200
SEED_BUDGET_CAP=2000000000
SEED_TIER0_AMOUNT=50000000
SEED_TIER1_AMOUNT=100000000
SEED_TIER2_AMOUNT=200000000
SEED_TREASURY_FUND=400000000
DEMO_OFFICIAL_KEY=suiprivkey1...         # generated by seed; exposed to browser only when SHOW_DEMO_LOGINS
DEMO_VERIFIER_KEY=suiprivkey1...
